{
  "name": "crewaid-connect",
  "version": "0.0.0",
  "description": "Connect a local repository and ACP coding harness (Claude Code, Codex, OpenCode, Antigravity) to Crewaid.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://crewaid.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natanael-Exe/crewaid.git",
    "directory": "packages/connector-cli"
  },
  "bin": {
    "crewaid-connect": "dist/bin.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/bin.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@crewaid/acp-core": "workspace:*",
    "@crewaid/shared": "workspace:*",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.3",
    "zod": "4.6.6"
  }
}
