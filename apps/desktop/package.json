{
  "name": "@crewaid/desktop",
  "productName": "Crewaid",
  "version": "0.1.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://crewaid.io",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite build --watch --outDir dist/renderer --emptyOutDir false & cross-env ELECTRON_START_URL=http://localhost:5173 node scripts/dev-electron.mjs",
    "dev:renderer": "vite --outDir dist/renderer",
    "start": "node scripts/dev-electron.mjs",
    "build": "tsc -b && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs && vite build --outDir dist/renderer",
    "typecheck": "tsc -b && tsc -p e2e/tsconfig.json",
    "lint": "eslint src e2e",
    "security:probe": "node scripts/security-probe.mjs",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**'",
    "test:e2e": "playwright test --config playwright.config.ts",
    "screen:probe": "node scripts/screen-lifecycle-probe.mjs",
    "package:cloud": "pnpm build && node scripts/package.mjs cloud",
    "package:selfhosted": "pnpm build && node scripts/package.mjs selfhosted",
    "package:dir": "pnpm build && node scripts/package.mjs selfhosted --dir",
    "icons": "python3 ../../tools/generate-icons.py"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@better-auth/electron": "1.7.26",
    "@better-auth/utils": "0.5.1",
    "@crewaid/brand": "workspace:*",
    "@crewaid/shared": "workspace:*",
    "@elevenlabs/client": "1.28.0",
    "@heroui/react": "3.2.8",
    "@heroui/styles": "3.2.8",
    "@internationalized/date": "3.12.4",
    "@novnc/novnc": "1.7.0",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tabler/icons-react": "3.46.0",
    "better-auth": "1.7.26",
    "electron-updater": "6.8.10",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.8",
    "react-pdf": "11.0.0",
    "rxjs": "7.8.1",
    "streamdown": "2.7.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vitest": "4.1.11"
  }
}
