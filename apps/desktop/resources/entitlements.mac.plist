<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- What Electron's V8 needs under the hardened runtime: electron-builder's
         own defaults, restated because naming a file replaces them. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- D-221: dictation and voice messages. Without it a signed build is
         refused the microphone and never shows the system prompt. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
