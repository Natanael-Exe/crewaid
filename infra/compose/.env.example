# Crewaid — environment. Copy to `.env` and fill in.
# PRD §7.3: every secret comes from the environment. No secret is ever passed
# into a sandbox container.

# ── Database (docker-compose) ────────────────────────────────────────────────
POSTGRES_USER=crewaid
POSTGRES_PASSWORD=crewaid
POSTGRES_DB=crewaid
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crewaid:crewaid@localhost:5432/crewaid?schema=public
# Optional for a hosted Neon deployment: Prisma CLI migrations use the direct
# URL while the running app keeps DATABASE_URL on the pooled URL. Local
# development needs only DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DB?sslmode=require

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_PORT=6379
# Required: docker compose refuses to start Redis without it. Generate with
#   openssl rand -hex 24
# (`scripts/docker-host-setup.sh` fills this and REDIS_URL in when blank.)
REDIS_PASSWORD=
# Required for skill compilation: a recording stopped without this
# fails with a readable error rather than becoming a skill. Everything else —
# chat, sandboxes, recording capture — works without it.
# The password goes after the colon. A password containing @ : / or # must be
# percent-encoded here (@ is %40), or the URL splits at the wrong place.
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# Whether this process CONSUMES skill.compile jobs as well as queuing them.
# 'false' turns one orchestrator into a producer only — which is what the test
# suite does, since a worker starts in every Nest context that has one.
SKILL_COMPILE_WORKER=true

# The same switch for §6/M7's bot-to-bot delivery. Separate from the
# one above because the two jobs cost different things: a compile is one model
# call, a delivery starts another bot's whole turn. Without REDIS_URL the
# send_message tool refuses with a result naming this, rather than pretending
# a message was sent.
BOT_MESSAGE_WORKER=true

# The same switch for §6/M8's routines: whether this process runs
# scheduled firings, and whether it reconciles the schedules in Redis against
# the database on boot. Run exactly one orchestrator with it on. Without
# REDIS_URL, saving a routine is refused rather than stored to never fire.
ROUTINE_WORKER=true

# How many hops one chain of bot-to-bot messages may take before it is cut
# (§6/M7's MAX_HOPS). D-047: the accounting always runs, but the ceiling ships
# OFF — 0, or absent, means no ceiling, because ten hops is roughly five round
# trips and a bot delegating all day exhausts that before lunch. Set it to 10
# for §6/M7's specified behaviour. When a chain is cut, both bots get a system
# message naming this key.
CHAIN_MAX_HOPS=0

# Every token every participant spends on one chain (§6/M7's 200,000). Same
# D-047 treatment: the accounting always runs and /usage prices it, but the
# ceiling ships OFF. 0, or absent, means no budget; set it to 200000 for
# §6/M7's specified behaviour. When a chain is cut both bots are told what it
# actually spent, not just what it was allowed.
CHAIN_MAX_TOKENS=0

# How many messages ONE bot may send to ONE other bot within a single chain
# (§6/M7's 3). Off by default for D-047's reason: three messages to the same
# bot per chain is a PM that may speak to its developer three times, ever. The
# counter always runs; this only decides whether it refuses. Unlike the two
# above, hitting it stops that PAIR rather than the whole chain.
CHAIN_MAX_REPEAT_SENDS=0

# ── Orchestrator ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Pino level: trace | debug | info | warn | error | fatal. Unset means info.
LOG_LEVEL=info


# ── Edition ──────────────────────────────────────────────────────────
# Which product this server is. REQUIRED: the orchestrator refuses to boot
# without it rather than guess, because it decides how people sign in.
#   cloud       Google, GitHub and magic-link sign-in (the settings below);
#               billing (below) and a built-in model provider, once it exists.
#   selfhosted  Email and password only — no identity provider or mail service
#               to configure, and the Google/GitHub/Resend settings are ignored.
#               Bring-your-own model keys only, and no billing.
# Pair it with the desktop build: an unpackaged app (`pnpm --filter
# @crewaid/desktop dev`) is self-hosted unless started with CREWAID_EDITION=cloud
# and CREWAID_ORCHESTRATOR_URL, and each edition's sign-in returns to its own
# app's scheme — a mismatched pair signs in and never comes back.
CREWAID_EDITION=selfhosted

# ── Billing — cloud edition only ─────────────────────────────────────
# The hosted service's plans, through Stripe. STRIPE_SECRET_KEY is the switch:
# unset, a cloud server runs unbilled — every account unlimited — and says so
# at boot. Set it and the rest are required, or the server refuses to boot.
# Ignored entirely on a selfhosted server. The cloud edition runs the Enterprise
# entrypoint, `pnpm orch:cloud` (dist/ee/main.js, D-238); `pnpm orch` refuses
# CREWAID_EDITION=cloud.
#   STRIPE_WEBHOOK_SECRET   the signing secret of the endpoint
#                           https://<BETTER_AUTH_URL>/api/v1/auth/stripe/webhook,
#                           sending checkout.session.completed and
#                           customer.subscription.created/updated/deleted
#   STRIPE_PRICE_STARTER    the $20/month recurring price
#   STRIPE_PRICE_PRO        the $100/month recurring price
#   The trial's one-time $1 is created at checkout; it needs no price here.
# STRIPE_AUTOMATIC_TAX=true turns on Stripe Tax at checkout; leave it off until
# the account's tax registrations are set up in Stripe. BILLING_RETURN_URL is the
# page Stripe sends the browser back to (default https://crewaid.io/billing/done).
# An admin account (`UPDATE "User" SET role = 'admin' WHERE email = '…'`) is on
# the internal plan: no charge and no limits.
# CREWAID_OPENROUTER_API_KEY switches on the models a plan includes: one
# Crewaid-paid OpenRouter key every account's included models run on, each call
# charged to its plan's allowance. Unset, plans bill computer time only and every
# account brings its own model keys. Set a spend limit on the key at OpenRouter
# as a backstop.
CREWAID_OPENROUTER_API_KEY=
# CREWAID_ELEVENLABS_API_KEY switches on voice for every account:
# dictation, voice messages and spoken replies run on one Crewaid-paid
# ElevenLabs key, each call charged to the plan's model allowance. Unset, an
# account adds its own key under Settings → Providers. Billing must be on.
CREWAID_ELEVENLABS_API_KEY=
# CREWAID_ELEVENLABS_AGENT_ID switches on calls: a live voice line to
# a bot, on Pro (30 minutes a period). It is the shared ElevenLabs agent that
# is only the voice; set it up as docs/VOICE-MODE.md describes. Needs the key
# above, and billing on.
CREWAID_ELEVENLABS_AGENT_ID=
# With billing on, computer time is counted every SANDBOX_METER_INTERVAL_MS
# (default 60000) and a computer stops when its owner's hours run out.
# SANDBOX_METER_INTERVAL_MS=60000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_AUTOMATIC_TAX=false
BILLING_RETURN_URL=

# ── Accounts (Better Auth, V1-02/V1-08) ──────────────────────────────────────
# Signing secret for sessions and magic links. Separate from CREDENTIAL_KEY and
# from the V1-03 keyring ON PURPOSE: one secret for both means rotating
# either forces rotating the other, and a leak of the session secret would also
# open every stored provider key.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin the orchestrator is reached at. OAuth callbacks are built from
# it, so a value that does not match what the browser actually loaded fails as
# a redirect_uri mismatch at the provider — not as anything Crewaid logs.
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in. A provider whose pair is blank is NOT REGISTERED rather than
# registered broken, so an install that only uses magic links boots fine and
# simply offers no button.
#
# The redirect URI to register with each provider is
#   $BETTER_AUTH_URL/api/v1/auth/callback/<provider>
# e.g. http://localhost:3000/api/v1/auth/callback/google — the /api/v1 prefix
# is easy to leave off, and the provider reports the mismatch, so the failure
# appears on Google's screen and never in a Crewaid log.
#
# The SAME Google client also connects the Gmail, Google Calendar and Google
# Drive plugins. Google's MCP servers accept no self-registered client,
# so they use this one — nothing to paste into the app. In that same client in
# Google Cloud Console:
#   1. add a second authorized redirect URI:
#        $BETTER_AUTH_URL/api/v1/mcp/oauth/callback
#   2. enable the Gmail API, Google Calendar API and Google Drive API;
#   3. add their scopes to the OAuth consent screen (Connect asks for exactly
#      the ones Google's MCP configuration guide lists).
# Google's MCP servers are currently in the Workspace Developer Preview, and
# the project must be enrolled for them to answer.
# ⚠️ An EXTERNAL consent screen left in "Testing" gets refresh tokens that
# expire after 7 days, so these plugins will need reconnecting weekly until the
# app is published. Google's docs do not say this applies to an Internal
# (Workspace) consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic links, delivered through Resend. Only needed if you want email sign-in;
# the client is built on first send, so an install without these still starts.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or every send 403s.
MAGIC_LINK_FROM=Crewaid <noreply@example.com>

# AES-256-GCM key encrypting MCP credentials at rest (PRD §7.3, M6).
# 32 bytes hex. Generate with: openssl rand -hex 32
CREDENTIAL_KEY=

# ── Provider credential vault ─────────────────────────────────
# The keyring encrypting PROVIDER API keys at rest, and every message:
# what people and their bots say is sealed under a key derived from this ring
# before it is stored. A production server refuses to start without it; outside
# production a missing ring stores messages unencrypted. Separate from
# CREDENTIAL_KEY (which is M6's MCP tokens) and from BETTER_AUTH_SECRET: one
# secret serving two purposes means rotating either forces rotating the other,
# so the rotation that should be routine becomes a sign-out for everybody and
# therefore never happens.
#
# ⚠️ KEEP THIS OUT OF THE DATABASE AND OUT OF DATABASE BACKUPS. A backup
# holding the ciphertext and the key that opens it is not encryption.
# ⚠️ AND KEEP A COPY SOMEWHERE ELSE. Without it no provider key and no
# conversation can be read again.
#
# JSON of version -> 64 hex characters (32 bytes, AES-256):
#   CREWAID_CREDENTIAL_KEYRING={"1":"<openssl rand -hex 32>"}
CREWAID_CREDENTIAL_KEYRING=

# Which version NEW credentials are written under. Optional while the ring
# holds exactly one key — with two or more it is REQUIRED, because "which one
# do new writes use" has no safe default and picking the highest would start a
# rotation nobody asked for.
# CREWAID_CREDENTIAL_KEY_ACTIVE=1
#
# ── Rotating ─────────────────────────────────────────────────────────────────
#  1. Generate a new key and ADD it to the ring, keeping the old one:
#       CREWAID_CREDENTIAL_KEYRING={"1":"<old>","2":"<new>"}
#       CREWAID_CREDENTIAL_KEY_ACTIVE=2
#     Both versions are loadable, so nothing stops working at this point.
#  2. Deploy. New and updated credentials now land under version 2; existing
#     rows still read under version 1.
#  3. Run the rotation pass for each user. It is idempotent and row-by-row, so
#     an interrupted run is simply re-run, and a row it cannot decrypt is
#     counted and skipped rather than stopping the pass.
#     Messages need no pass of their own: the orchestrator reseals them under
#     the active version each time it starts, and
#     `node apps/orchestrator/dist/cli/seal-messages.js` does it on demand and
#     prints how many rows it moved. Zero means none are left under version 1.
#  4. Only once no row reports version 1, remove it from the ring.
#     Removing it earlier makes those rows permanently unreadable — the error
#     says "may have been retired before every row using it was rotated",
#     which is the one failure here that cannot be undone.
#
# ── Recovering ───────────────────────────────────────────────────────────────
# There is no recovery from a lost key: the ciphertext is not decryptable and
# no copy of the plaintext exists anywhere (D-083 — a key goes in and never
# comes back). Recovery is re-entry. Clear the affected connections' keys and
# ask their owners to supply them again; the connections and their models
# survive, and only the credentials need replacing.

# ── Artifact storage ─────────────────────────────────────────────────
# Attachments, files bots attach, and recording screenshots
# (Attachment.storageKey and RecordingEvent.screenshotKey) go to ONE store:
#
#   - R2, when all four ARTIFACT_R2_* keys below are set. Nothing is written to
#     this host's disk. A cloud server running as production (NODE_ENV=production)
#     refuses to start without them.
#   - ARTIFACT_DIR otherwise (self-hosted, and local development).
#
# Some R2 keys without the others refuses to start in either edition.
# Use an R2 API token scoped to "Object Read & Write" on this one bucket.
ARTIFACT_R2_ACCOUNT_ID=
ARTIFACT_R2_ACCESS_KEY_ID=
ARTIFACT_R2_SECRET_ACCESS_KEY=
ARTIFACT_R2_BUCKET=

# Where artifacts are written when R2 is not configured.
ARTIFACT_DIR=./.artifacts

# Per-user artifact quota in MB across every attachment a user owns, claimed or
# not, in either store. 10240 = 10 GiB.
ARTIFACT_MAX_USER_MB=10240

# Disk store only: cumulative quota in MB across all users' attachments.
ARTIFACT_MAX_TOTAL_MB=2048

# Disk store only: minimum free space in MB on the ARTIFACT_DIR volume; 0
# disables the check.
ARTIFACT_MIN_FREE_MB=200

# Artifact reaper sweep interval in ms; 0 disables the periodic sweep. With
# REDIS_URL set, this is a BullMQ job scheduler (one pass per interval for the
# whole deployment, surviving restarts); without it, an in-process timer.
ARTIFACT_REAP_INTERVAL_MS=3600000

# Run the reaper once at startup; true or false.
ARTIFACT_REAP_ON_BOOT=true

# ── Model providers ──────────────────────────────────────────────────────────
# ⚠️ OPENROUTER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY AND DEFAULT_MODEL_ID
# ARE GONE. Nothing reads them, and leaving them here
# would tell an operator that filling them in configures something.
#
# A provider key is a per-user row now, encrypted under CREWAID_CREDENTIAL_KEYRING
# and added in Settings → Models. A process-wide key could not be correct on an
# install with two users: whichever one it held belonged to somebody, and every
# turn billed it.
#
# The `default` alias on `Bot.modelId` survives and resolves per-user against
# `UserSettings.defaultModelId` — also chosen in Settings, not here. R3 still
# holds: model access goes through the AI SDK's provider abstraction, and
# nothing calls a provider's HTTP API directly.

# ── Agent loop (PRD §6/M5) ───────────────────────────────────────────────────
# How many STEPS one user turn may take, where a step is one model call plus
# whatever tools it asked for. §6/M5 specifies 25 and specifies it as a
# default, not a constant. The AI SDK's own default is 20, so this is always
# passed to the agent explicitly — never left to the framework. There is no
# "unlimited": a bad value fails at boot.
AGENT_MAX_STEPS=25

# The input-token size at which a step trims the turn's context before the
# next model call. Measured from the PREVIOUS step's usage as the provider
# counted it, not estimated. Trimming drops reasoning and the payloads of all
# but the most recent tool round; the bot's instructions, the triggering
# message and the newest tool result always survive.
#
# This is not a §7.2-style cap and D-047 does not apply to it: trimming is
# what lets a long turn CONTINUE. Raise it to trim less often and send more
# context per call, until the provider's own window refuses the turn instead.
AGENT_CONTEXT_TRIM_TOKENS=100000

# §6/M5's other two per-turn ceilings, and the one place they differ from the
# step ceiling above: both ship OFF. D-047 — limits are the operator's, not
# the product's — so the accounting always runs and the refusal is opt-in.
# Absent or 0 means no ceiling; a malformed value fails at boot.
#
# The numbers §6/M5 specifies are below, commented out, so setting them is a
# matter of uncommenting rather than remembering.
#
# ACCUMULATED input tokens, summed over the turn's steps. It grows faster than
# it looks: a turn re-sends its history on every step, so twenty steps holding
# a steady 8k of context have accumulated 160k without ever sending a large
# prompt. AGENT_CONTEXT_TRIM_TOKENS is what keeps a long turn under this.
# AGENT_MAX_TURN_TOKENS=150000
#
# Milliseconds the turn spends WORKING. Time the turn sits suspended waiting
# for someone to answer an approval is not counted — what this bounds is a
# runaway loop, and a turn waiting on a person is the opposite of one.
# AGENT_MAX_TURN_MS=600000

# M5-BE-19. How many times a turn stopped by a CEILING may carry on before it
# stops and waits for a person. §6/M5 ends such a turn with a system message
# and IDLE, and nothing reads that message — so a bot with half a task done
# stopped until a human arrived. Three continuations is four turns, which is
# 100 steps at the default step ceiling. It needs a bound of its own because
# two of the three ceilings ship off, so "the limits will stop it" is
# not true here. 0 restores §6/M5's stop-and-wait.
# AGENT_MAX_CONTINUATIONS=3

# M5-BE-29. How many earlier messages a turn is seeded with, so a bot can hold
# a conversation instead of answering every message as if it were the first.
# Counted in messages because the seed is text-only; growth WITHIN a turn is
# the context trim's job. 0 seeds none.
# AGENT_HISTORY_MESSAGES=40

# CC-33. The seed's OTHER bound: a message COUNT says nothing about size, so
# forty pasted stack traces and forty short exchanges are the same number and
# nowhere near the same prompt. A backstop against pathological messages, not
# a second opinion on how much history is useful. The window stays contiguous
# — it stops at the first message that does not fit rather than skipping one,
# because a reply whose question was dropped reads as a non-sequitur.
# 0 leaves only the count.
# AGENT_HISTORY_CHARS=24000

# CC-32 / D-076. How much of every prompt the bot's standing memory may take,
# in CHARACTERS. Small because the multiplier is large: `instructions` is
# re-sent on every model call of every STEP, so 2,000 characters on a 25-step
# turn is ~12,500 tokens of memory, not 500. Characters rather than tokens
# because there is no tokenizer here and a third-party one would give a precise
# number about a different model. 0 injects none.
# AGENT_MEMORY_BUDGET_CHARS=2000

# CC-38 / D-078. Automatic extraction: a background sweep that reads recent
# conversations and proposes durable facts. OFF, and 0 is the default — not
# out of caution about cost, but because D-064 puts remember/forget on the
# `ask` fallthrough, so the operator was promised memory writes are approved
# and a background worker writing them silently revokes that. Turning it on is
# a product-policy decision. Everything it writes lands as CANDIDATE:
# searchable, never injected, so a wrong inference is a search result rather
# than a standing truth.
# AGENT_MEMORY_DISTILL_INTERVAL_MS=0
# How many new messages a bot must accumulate before a pass is worth a model
# call. Triggered by work, not by the clock, so it does not pay to read "thanks".
# AGENT_MEMORY_DISTILL_MIN_MESSAGES=8

# ── Cost ──────────────────────────────────────────────────────────
# There is no token cap. CC-26 removed it (it had already shipped off by
# default under D-047): a user pays to get work done, not to have their tokens
# managed for them, and a product that refuses work nobody asked it to refuse
# is the product choosing. `/usage` reports what was spent; nothing
# enforces a ceiling. When a provider account runs dry the answer is another
# model — switch it in the composer and tell the bot to carry on, which is
# what the QUOTA_EXCEEDED message says. V2-BE-01 makes that automatic.

# ── Sandbox (PRD §5.1, M2) ───────────────────────────────────────────────────
# Where customer computers run: `docker` (the default)
# runs them on this host's Docker daemon; `digitalocean` runs each as a
# DigitalOcean Harness Runtime session; `cloudflare` runs each as a Cloudflare
# Container behind the control Worker in infra/cloudflare/control-worker;
# `runtime` runs each as a Runtime (withruntime.com) sandbox; `instabox` runs
# each inside an Instabox (instabox.sh) Firecracker VM. An unknown value fails
# at boot rather than falling back.
# SANDBOX_PROVIDER=docker
# With digitalocean: a token that can manage Harness Runtime sessions and
# templates (orchestrator only — never passed into a machine), the custom
# template built from the sandbox image, and optionally size and base adapter.
# DIGITALOCEAN_ACCESS_TOKEN=
# SANDBOX_DO_TEMPLATE=crewaid-sandbox
# SANDBOX_DO_SIZE=mars-4vcpu-8gb
# SANDBOX_DO_BASE_ADAPTER=opencode
# With cloudflare: the control Worker's https URL and its CONTROL_SECRET
# (orchestrator only — never passed into a machine).
# SANDBOX_CF_CONTROL_URL=https://crewaid-computers.<subdomain>.workers.dev
# SANDBOX_CF_CONTROL_SECRET=
# With runtime: an API key (orchestrator only — never passed into a machine),
# the sandbox image on Runtime, and optionally the size of each computer. Each
# release puts its image there and moves `latest`, and a computer on an older
# version is switched on its next start; a fixed tag pins every
# computer to it. By hand: pnpm --filter @crewaid/sandbox-runtime build-image.
# RUNTIME_API_KEY=
# SANDBOX_RUNTIME_IMAGE=crewaid-sandbox:latest
# SANDBOX_RUNTIME_VCPU=4
# SANDBOX_RUNTIME_MEMORY_MIB=8192
# SANDBOX_RUNTIME_DISK_MIB=20480
# With instabox: an Instabox API key scoped to machines:read, machines:write
# and machines:delete (orchestrator only — never passed into a machine).
# Works on Instabox's Free plan (1 sandbox, 4 vCPU / 8 GiB / 20 GiB /data):
# set SANDBOX_MAX_RUNNING=1 and omit the VCPU/MEMORY_MIB overrides. Note that
# Free-plan sandboxes have a fixed 30-minute idle suspend and a continuous run
# cap (up to 8 hours) followed by a cooldown; they cannot run always-on 24/7.
# INSTABOX_API_KEY=
# SANDBOX_INSTABOX_IMAGE=ghcr.io/natanael-exe/crewaid-sandbox:latest
# SANDBOX_INSTABOX_TEMPLATE=agent-browser
# Paid Instabox plans only (must be set together, or both omitted):
# SANDBOX_INSTABOX_VCPU=4
# SANDBOX_INSTABOX_MEMORY_MIB=8192
# INSTABOX_API_URL=https://api.instabox.sh
SANDBOX_IMAGE=crewaid/sandbox:dev
SANDBOX_NETWORK=agent-net
# With docker: the sandbox supervisor, the one process with the Docker socket
#. The orchestrator signs its requests with this secret; start the
# supervisor with the same environment:
#   pnpm --filter @crewaid/sandbox-supervisor build
#   node --env-file=infra/compose/.env packages/sandbox-supervisor/dist/main.js
# The image, network, publish address and limits below are the supervisor's to
# enforce; the orchestrator must name the same image and network.
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7300
#   openssl rand -hex 32
SANDBOX_SUPERVISOR_SECRET=
# Optional, for the supervisor: host bridge IPv4 reachable by a containerized orchestrator.
# Unset keeps local development on 127.0.0.1. Never use 0.0.0.0 or a public IP.
# SANDBOX_PUBLISH_ON=172.17.0.1
# How the supervisor publishes a computer's ports: `published` (default,
# on SANDBOX_PUBLISH_ON) or `network` (nothing published; the orchestrator must
# share SANDBOX_NETWORK, as in infra/selfhost).
# SANDBOX_CONNECT=published
# R8: fixed for a sandbox's entire lifetime. Never renegotiated.
SANDBOX_WIDTH_PX=1280
SANDBOX_HEIGHT_PX=800

# How many sandboxes may run at once (D-039 §7). A start beyond this is refused
# with 503 SANDBOX_CAPACITY rather than queued. The default follows PRD §7.5's
# sizing (six bots on 8 vCPU / 16 GB) and is a measurement target, not a proven
# guarantee. There is no "unlimited": a bad value fails at boot.
SANDBOX_MAX_RUNNING=6

# Stop a sandbox that has been doing nothing for this long (D-039 §8). A turn,
# a recording, manual takeover or a keep-running lease all count as doing
# something; watching the screen does not. `0` disables it.
SANDBOX_IDLE_STOP_MS=1800000

# How often the health sweep probes each running sandbox. `0` disables it —
# which is what the test suite does, since the sweep walks every Sandbox row.
SANDBOX_HEALTH_INTERVAL_MS=15000

# Reconcile database rows against the real containers at startup. `false` turns
# it off, which is what a process sharing a database with others needs: the
# pass is host-wide and would otherwise adopt or stop another context's rows.
SANDBOX_RECONCILE_ON_BOOT=true
# Deleted-bot workspace grace period; positive whole days, runtime removed immediately.
SANDBOX_WORKSPACE_RETENTION_DAYS=7

# Seeded singleton user's email (optional, PRD §3 / R7).
SEED_USER_EMAIL=

# Human takeover: leases renew every 10s while the expanded view has focus.
SEAT_CONTROL_DRAIN_MS=5000
SEAT_CONTROL_LEASE_MS=30000
SEAT_CONTROL_AGENT_WAIT_MS=120000

# App integrations (both editions): server-only Composio project credentials.
# The Plugins directory lists the project's whole managed-OAuth toolkit catalog
#; auth configs are provisioned at install, so this is the only variable.
COMPOSIO_API_KEY=

# Direct GitHub plugin uses GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET above in both
# editions. Add ${BETTER_AUTH_URL}/api/v1/mcp/oauth/callback to that OAuth app.
# See docs/GITHUB-GIT.md for scopes and sandbox setup.
# Telegram mobile channel. Each person connects their own bot.
# The HTTPS origin Telegram can reach (no path); leave empty to disable the channel.
# Needs REDIS_URL and CREDENTIAL_KEY: people's bot tokens are sealed with it.
TELEGRAM_PUBLIC_URL=
# Optional: a manager bot (BotFather → Bot Settings → Bot Management Mode on) lets
# people create their bot from a QR code. Set both or neither.
TELEGRAM_MANAGER_BOT_TOKEN=""
# Generate with: openssl rand -hex 32
TELEGRAM_MANAGER_WEBHOOK_SECRET=""
# Set false on API-only processes; at least one process must consume the queue.
TELEGRAM_WORKER=true
