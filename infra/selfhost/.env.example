# Self-hosted Crewaid. `npx crewaid-selfhost init` writes this file for
# you, with every secret generated; fill it in by hand only to install without
# the installer. Keep it private (chmod 600): it holds the keys to everything.

# The release to run: the images are ghcr.io/natanael-exe/crewaid-*:<version>.
CREWAID_VERSION=0.0.3

# The address the desktop app uses to reach this server, exactly as typed into
# it. http://localhost:3000 for this computer only; http://<lan-ip>:3000 for a
# local network (unencrypted: passwords cross it in clear); https://<domain>
# with the `https` profile below for anything reachable from the internet.
BETTER_AUTH_URL=http://localhost:3000

# Where the orchestrator listens on this machine. 127.0.0.1 keeps it to this
# computer; 0.0.0.0 opens it to the network (for the LAN address above).
CREWAID_BIND=127.0.0.1
CREWAID_PORT=3000

# HTTPS by domain: start with `docker compose --profile https up -d` and point
# the domain's DNS at this machine (ports 80 and 443 open).
# CREWAID_DOMAIN=crewaid.example.com

# Secrets. Hex, because the passwords go into connection URLs.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts the model provider keys people save. JSON of version -> 64 hex:
#   CREWAID_CREDENTIAL_KEYRING={"1":"<openssl rand -hex 32>"}
CREWAID_CREDENTIAL_KEYRING=
# Encrypts plugin (MCP) credentials. 64 hex: openssl rand -hex 32
CREDENTIAL_KEY=
# Signs the orchestrator's requests to the sandbox supervisor, the one service
# with the Docker socket. 64 hex: openssl rand -hex 32
# To rotate: move the current value to SANDBOX_SUPERVISOR_SECRET_PREVIOUS, set a
# new one here, `docker compose up -d`, then remove the previous line and run
# `docker compose up -d` again.
SANDBOX_SUPERVISOR_SECRET=
# SANDBOX_SUPERVISOR_SECRET_PREVIOUS=

# Computers running at once. Each is a desktop with Chrome: about 2 CPUs and
# 4 GB of memory to be comfortable.
SANDBOX_MAX_RUNNING=2

# Optional: run computers on Instabox (instabox.sh) instead of local Docker
# using `docker compose -f compose.instabox.yml up -d`. Instabox's Free plan
# includes 1 sandbox (4 vCPU / 8 GiB / 20 GiB /data) at $0/mo: set
# SANDBOX_MAX_RUNNING=1 and omit VCPU/MEMORY_MIB. Free-plan sandboxes pause
# after 30 min idle and after at most 8 hours of continuous run (followed by a
# cooldown), so they cannot run always-on 24/7.
# Create a scoped key (machines:read, machines:write, machines:delete) in the
# Instabox dashboard.
# INSTABOX_API_KEY=
# SANDBOX_INSTABOX_IMAGE=ghcr.io/natanael-exe/crewaid-sandbox:latest
# SANDBOX_INSTABOX_TEMPLATE=agent-browser
# Paid Instabox plans only (set both or neither):
# SANDBOX_INSTABOX_VCPU=4
# SANDBOX_INSTABOX_MEMORY_MIB=8192

# The computers' network, and the orchestrator's fixed address on it (the one
# address the egress fence lets into a computer). Change both together, and
# only if the range collides with a network this machine already has.
# CREWAID_SANDBOX_SUBNET=10.231.0.0/24
# CREWAID_ORCHESTRATOR_ADDRESS=10.231.0.2

# Human takeover: leases renew every 10s while the expanded view has focus.
SEAT_CONTROL_DRAIN_MS=5000
SEAT_CONTROL_LEASE_MS=30000
SEAT_CONTROL_AGENT_WAIT_MS=120000
