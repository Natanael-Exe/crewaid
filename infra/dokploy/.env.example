# Enter these in Dokploy's Environment tab. Dokploy creates the .env file next
# to compose.yml. Keep local infra/compose/.env pointing at local Postgres.
# Set this to the immutable release being deployed, especially with compose.runtime.yml.
CREWAID_RELEASE_TAG=v0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLED-HOST/DB?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DB?sslmode=require
BETTER_AUTH_URL=https://crewaid.example.com
BETTER_AUTH_SECRET=
CREWAID_CREDENTIAL_KEYRING=
CREDENTIAL_KEY=
# Redis's password; the Compose file builds REDIS_URL from it. openssl rand -hex 24
REDIS_PASSWORD=
# Configure at least one sign-in method using the keys in infra/compose/.env.example.
# Required on production cloud. Use matching keys, webhook and prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Every file (attachments, bots' files, recording screenshots) is stored in this
# R2 bucket, never on the host (D-220); the orchestrator refuses to start
# without all four. Create an R2 API token with "Object Read & Write" on this
# one bucket; its S3 credentials are the access key id and secret.
ARTIFACT_R2_ACCOUNT_ID=
ARTIFACT_R2_ACCESS_KEY_ID=
ARTIFACT_R2_SECRET_ACCESS_KEY=
ARTIFACT_R2_BUCKET=
# Per-user file storage cap in MB; defaults to 10240 (10 GiB).
# ARTIFACT_MAX_USER_MB=10240
SANDBOX_IMAGE=crewaid/sandbox:dev
SANDBOX_NETWORK=agent-net
# The crewaid-control network's gateway (README step 5):
#   docker network inspect crewaid-control -f '{{(index .IPAM.Config 0).Gateway}}'
SANDBOX_PUBLISH_ON=
SANDBOX_MAX_RUNNING=2
# Signs the orchestrator's requests to the sandbox supervisor, the one service
# with the Docker socket (D-200). openssl rand -hex 32. To rotate, see
# infra/selfhost/.env.example.
SANDBOX_SUPERVISOR_SECRET=
# On a 2-vCPU / 8-GB host, reduce the container cap and allow only one computer:
# SANDBOX_CPUS=2
# SANDBOX_MEMORY_MIB=5120
# SANDBOX_MAX_RUNNING=1
# Computers on DigitalOcean (compose.digitalocean.yml; README, last section)
# instead of the group above. SANDBOX_PROVIDER is set by that Compose file.
# DIGITALOCEAN_ACCESS_TOKEN=
# SANDBOX_DO_TEMPLATE=crewaid-sandbox-<release>
# SANDBOX_DO_SIZE=mars-4vcpu-8gb
# SANDBOX_DO_BASE_ADAPTER=opencode
# Computers on Cloudflare (compose.cloudflare.yml; infra/cloudflare/control-worker)
# instead of the group above. SANDBOX_PROVIDER is set by that Compose file.
# SANDBOX_CF_CONTROL_URL=https://crewaid-computers.<subdomain>.workers.dev
# SANDBOX_CF_CONTROL_SECRET=
# Computers on Runtime (compose.runtime.yml; README, last section) instead of
# the group above. SANDBOX_PROVIDER is set by that Compose file.
# RUNTIME_API_KEY=
# SANDBOX_RUNTIME_IMAGE=crewaid-sandbox:latest
# SANDBOX_RUNTIME_VCPU=4
# SANDBOX_RUNTIME_MEMORY_MIB=8192
# SANDBOX_RUNTIME_DISK_MIB=20480

# Server-only app integrations; the deployment's Composio project. Auth configs
# are provisioned at install time, so this is the only variable (D-204).
COMPOSIO_API_KEY=
